APP_NAME="SIH3"
APP_ENV=local
APP_KEY=base64:YOUR_APP_KEY_HERE # Ganti dengan APP_KEY hasil dari `php artisan key:generate`
APP_DEBUG=true
APP_SCHEME=http
APP_URL=http://localhost:8756 # Sesuaikan dengan URL aplikasi
APP_ASSET_URL=http://localhost:8756 # Sesuaikan dengan URL asset
APP_PORT=8756 # Sesuaikan kalau port host berbeda
SERVER_PORT=8756 # Sesuaikan kalau port host berbeda

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql # Sesuaikan nama host database (docker service name atau IP)
DB_PORT=5432
DB_DATABASE=demo_database # Ganti dengan nama database yang digunakan
DB_USERNAME=demo_user # Ganti dengan username database
DB_PASSWORD=demo_password # Ganti dengan password database

PGSQL_DB_CONNECTION=pgsql
PGSQL_DB_HOST=pgsql # Sama seperti DB_HOST
PGSQL_DB_PORT=5432
PGSQL_DB_DATABASE=demo_database # Sama seperti DB_DATABASE
PGSQL_DB_USERNAME=demo_user # Sama seperti DB_USERNAME
PGSQL_DB_PASSWORD=demo_password # Sama seperti DB_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=redis # Sesuaikan dengan host redis
REDIS_PASSWORD=demo_redis_password # Ganti dengan password redis
REDIS_PORT=6379
FORWARD_REDIS_PORT="${REDIS_PORT}"

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1 # Sesuaikan kalau pakai SMTP eksternal
MAIL_PORT=2525 # Sesuaikan port SMTP
MAIL_USERNAME=null # Isi jika SMTP butuh autentikasi
MAIL_PASSWORD=null # Isi jika SMTP butuh autentikasi
MAIL_FROM_ADDRESS="hello@example.com" # Sesuaikan alamat pengirim
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID= # Isi jika pakai S3
AWS_SECRET_ACCESS_KEY= # Isi jika pakai S3
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET= # Isi jika pakai S3
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_HOST="localhost" # Sesuaikan jika pakai domain dev
VITE_PORT=5173 # Port untuk Vite
VITE_BASE_URL=http://localhost:5173 # Sesuaikan kalau beda domain

MEDIA_DISK=media
OCTANE_HTTPS=true

ELASTICSEARCH_HOST=http://elasticsearch # Sesuaikan dengan host Elasticsearch
ELASTICSEARCH_PORT=9200

CACHE_DRIVER=redis

APP_SERVICE=app
WWWUSER=1000
WWWGROUP=1000
PWD=/var/www/html
